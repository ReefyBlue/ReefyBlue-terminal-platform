# Kopieer naar deploy/.env en pas aan. Alle tijden in seconden.
# Scenario-bestand uit deploy/scenarios/ (bind-mount: wisselen zonder rebuild)
SCENARIO=soak.yaml
# Overschrijft speed_factor uit het scenario (1 = echte tijd)
SPEED_FACTOR=1
# Duur van de soak-run in uren
SOAK_HOURS=72
# Verbindingscut ECS <-> gateway: elke CUT_EVERY_S, CUT_FOR_S lang
CUT_EVERY_S=14400
CUT_FOR_S=30
# 1 = storingen en onbekende uitkomsten vanzelf vrijgeven; 0 = handmatig via de viewer
AUTO_RELEASE=1
# Driver: nieuwe batch als open orders onder LOW_WATER zakken; BATCH containers per batch
LOW_WATER=40
BATCH=60
